# Copy to .env and fill in real values. .env is gitignored — NEVER commit real secrets.
# For local parity tests use the TEST values in src/test/resources/parity-fixtures.md,
# NOT production secrets. Do not point MONGO_READ_URI at production from a laptop/CI.

# --- Shared MongoDB (same DB as the Node service; read connection for Week-1) ---
MONGO_READ_URI=mongodb://localhost:27017/main
# Optional pool/timeout overrides (sensible defaults exist in MongoConfig):
# MONGO_MAX_POOL_SIZE=100
# MONGO_MIN_POOL_SIZE=5
# MONGO_SERVER_SELECT_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=20000

# --- Shared Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Must MATCH the Node service exactly, or tokens/payloads won't interoperate ---
CRYPTO_SECRET_KEY=
JWT_SECRET=

# --- Server ---
PORT=8081
TOMCAT_MAX_THREADS=200

# --- CORS: comma-separated origins; lock down in production ---
CORS_ALLOWED_ORIGINS=*
# Keep false until every migrated write has passed Node-vs-Java contract and DB-side-effect checks.
MIGRATION_WRITES_ENABLED=false

# --- Internal service integrations (no production fallback) ---
CHAT_SERVER_URL=

# --- Socket.IO migration server: keep off until mobile/client contract tests pass ---
SOCKET_ENABLED=false
SOCKET_PORT=8082
CALL_EXECUTION_ENABLED=false

# --- Scheduled writers: enable on exactly one reviewed worker instance only ---
CRON_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false
CRON_RECHARGE_OFFER=0 0 0 * * *
CRON_PAYMENT_RECONCILE=0 */5 * * * *

# --- AWS S3 media upload ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_PROJECT_NAME=Vedic_Meet

# --- Payment providers (test credentials only on developer machines/CI) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYTM_ENABLED=false
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_BASE_URL=
PAYTM_CALLBACK_URL=
PAYTM_WEBSITE_NAME=
PHONEPE_ENABLED=false
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_AUTH_URL=
PHONEPE_STATUS_BASE_URL=
# Public click-attribution/deep-link configuration
TRACKING_WEBSITE_INSTALL_URL=https://vedicmeet.com/install
TRACKING_APP_STORE_URL=
TRACKING_APP_SCHEME=
TRACKING_ANDROID_PACKAGE_NAME=
TRACKING_IOS_APP_ID=
TRACKING_MATCHING_WINDOW_DAYS=7
TRACKING_CLICK_EXPIRATION_DAYS=30
